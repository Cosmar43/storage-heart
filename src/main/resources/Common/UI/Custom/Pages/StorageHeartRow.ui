// One item variant row, styled like a Hytale container slot.
@RowLabel = LabelStyle(FontSize: 15, TextColor: #d3d6db, VerticalAlignment: Center);
@RowQty = LabelStyle(FontSize: 15, TextColor: #E8A93B, RenderBold: true, VerticalAlignment: Center);
@RowButtonLabel = LabelStyle(
  FontSize: 13,
  TextColor: #bdcbd3,
  RenderBold: true,
  RenderUppercase: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center,
  ShrinkTextToFit: true,
  MinShrinkTextToFitFontSize: 9
);

@RowSecondaryButton = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary.png", Border: 10)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 10)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 10)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 10))
);

@RowTertiaryButton = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../Common/Buttons/Tertiary.png", Border: 10)),
  Hovered: (Background: PatchStyle(TexturePath: "../Common/Buttons/Tertiary_Hovered.png", Border: 10)),
  Pressed: (Background: PatchStyle(TexturePath: "../Common/Buttons/Tertiary_Pressed.png", Border: 10)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 10))
);

Group {
  LayoutMode: Top;
  Anchor: (Bottom: 2);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 48);
    Padding: (Horizontal: 6);
    Background: (Color: #0b1118(0.30));

    ItemSlot #Icon {
      Anchor: (Width: 44, Height: 44, Right: 8);
      ShowQualityBackground: true;
      ShowQuantity: false;
    }

    Label #Name {
      FlexWeight: 1;
      Style: @RowLabel;
      Text: "";
    }

    Label #Qty {
      Anchor: (Right: 10);
      Style: @RowQty;
      Text: "";
    }

    Button #Get {
      Anchor: (Top: 10, Right: 6, Height: 28);
      Padding: (Horizontal: 8);
      Style: @RowSecondaryButton;
      Label #GetLbl {
        Style: @RowButtonLabel;
        Text: "One";
      }
    }

    Button #All {
      Anchor: (Top: 10, Height: 28);
      Padding: (Horizontal: 8);
      Style: @RowTertiaryButton;
      Label #AllLbl {
        Style: @RowButtonLabel;
        Text: "All";
      }
    }
  }

  Group {
    Anchor: (Height: 1, Top: 2);
    Background: #19252F;
  }
}

